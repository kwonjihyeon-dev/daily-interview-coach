# 브라우저가 apps/api를 직접 호출하는 데 쓰는 base URL. 비밀값이 아니므로 NEXT_PUBLIC_
# 접두사로 클라이언트에 노출한다. GateForm이 credentials:"include"로 이 값을 사용한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_KEY=

# Next.js 서버 프로세스 자신이 SSR 중 apps/api를 호출할 때 쓰는 base URL(apiClient.ts의
# apiGet/apiPost/apiPut/apiDelete가 참조).
API_BASE_URL=http://localhost:3001
